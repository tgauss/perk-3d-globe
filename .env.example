# Use mock data for testing (set to false when Metabase is configured)
USE_MOCK_DATA=true

# Metabase Configuration
METABASE_URL=https://metabase.perk.studio/
METABASE_USERNAME=your-metabase-username
METABASE_PASSWORD=your-metabase-password

# Optional: IPInfo Token for enhanced geolocation (if not provided, uses ipapi.co)
IPINFO_TOKEN=your-ipinfo-token